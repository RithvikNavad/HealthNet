{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "healthnet-rithvik",
  "workers_dev": true,
  "preview_urls": false,
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "healthnet-rithvik-db",
      "database_id": "7741397a-046a-43e1-bc35-71c910bd5b9c"
    }
  ],
  "observability": {
    "enabled": true
  }
}
